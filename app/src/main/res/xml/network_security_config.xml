<?xml version="1.0" encoding="utf-8"?>
<!--
  Дозволяє cleartext-HTTP лише для локального mock-сервера (ПЗ10).
  Погодний API Open-Meteo працює по HTTPS і в конфігурації не потребує.
  Якщо сервер доступний за LAN-IP замість adb reverse — додати цю адресу
  як <domain> у список нижче.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
